  "shortcuts": [
    {
      "name": "Aidat Öde",
      "short_name": "Aidat",
      "description": "Hızlı aidat ödeme ve borç sorgulama",
      "url": "/uygulama?tab=aidat",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Arıza Bildir",
      "short_name": "Arıza",
      "description": "Fotoğraflı arıza ve talep bildirimi",
      "url": "/uygulama?tab=ariza",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Duyurular",
      "short_name": "Duyuru",
      "description": "Site ve apartman duyuruları",
      "url": "/uygulama?tab=duyuru",
      "icons": [
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "/uygulama",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "file_handlers": [
    {
      "action": "/uygulama",
      "name": "Excel ve CSV Listeleri",
      "accept": {
        "text/csv": [".csv"],
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": [".xlsx"]
      }
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+konutpanel",
      "url": "/uygulama?action=%s"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/desktop-1280x720.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Konut Panel Yönetim Paneli - Masaüstü Görünümü"
    },
    {
      "src": "/screenshots/mobile-720x1280.png",
      "sizes": "720x1280",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Konut Panel Sakin Paneli - Mobil Görünümü"
    }
  ]
}
