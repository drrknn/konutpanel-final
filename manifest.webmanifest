{
  "name": "Konut Panel - Site ve Apartman Yönetim Programı",
  "short_name": "Konut Panel",
  "description": "Site ve apartman yönetimi: aidat takibi, şeffaf kasa, arıza-talep ve dijital yönetim.",
  "start_url": "/?source=pwa",
  "scope": "/",
  "id": "/?source=pwa",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "tabbed",
    "standalone",
    "browser"
  ],
  "background_color": "#0B0B0F",
  "theme_color": "#0B0B0F",
  "orientation": "any",
  "lang": "tr",
  "dir": "ltr",
  "categories": [
    "business",
    "productivity"
  ],
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "play",
      "id": "com.konutpanel.app",
      "url": "https://play.google.com/store/apps/details?id=com.konutpanel.app"
    }
  ],
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "handle_links": "preferred",
  "edge_side_panel": {
    "preferred_width": 480
  },
  "icons": [
    {
      "src": "/icons/icon-48.png",
      "sizes": "48x48",
      "type": "image/png",
      "purpose": "any"
    },
    {
