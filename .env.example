# ─────────────────────────────────────────────────────────────
# Konut Panel — ortam değişkenleri
# Bu dosyayı .env olarak kopyalayıp değerleri doldurun.
# Netlify'da: Site settings > Environment variables
# ─────────────────────────────────────────────────────────────

# Site
SITE_URL=https://konutpanel.com

# Supabase — Project Settings > API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend — işlemsel e-posta gönderimi (resend.com)
RESEND_API_KEY=
RESEND_FROM="Konut Panel <info@konutpanel.com>"

# Google Gemini — yapay zekâ ile makale üretimi
GEMINI_API_KEY=
